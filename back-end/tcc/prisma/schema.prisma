generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id             String   @id @default(uuid())
  nome           String
  dataNascimento DateTime
  cpf            String   @unique
  email          String   @unique
  senha          String
  avatar         String?
  createdAt      DateTime @default(now())

  // Última redefinição de senha: tokens de login emitidos antes dela deixam de valer
  senhaAlteradaEm DateTime?
  
  fk_idEndereco String   @unique
  endereco      Endereco @relation(fields: [fk_idEndereco], references: [id])

  carros     Carro[]
  reservas   ReservaCli[]
  feedbacks  Feedback[]
  reembolsos Reembolso[]
}

model Endereco {
  id     String @id @default(uuid())
  rua    String
  numero String
  bairro String
  cidade String
  estado String
  cep    String

  usuario        Usuario?
  estacionamento Estacionamento?
}

model Carro {
  id           String  @id @default(uuid())
  placacarro   String  @unique
  modelo       String
  fk_idCliente String
  usuario      Usuario @relation(fields: [fk_idCliente], references: [id], onDelete: Cascade)

  reservas ReservaCli[]

  @@index([fk_idCliente])
}

model ReservaCli {
  id             String    @id @default(uuid())
  data           DateTime  @default(now())
  hora           DateTime  @default(now())
  horaSaida      DateTime?
  entradaEm      DateTime?
  saidaEm        DateTime?
  codigoPresenca String?
  codigoSaida    String?
  fk_idCliente   String
  fk_idReserva   String
  fk_idCarro     String?

  usuario Usuario @relation(fields: [fk_idCliente], references: [id], onDelete: Cascade)
  reserva Reserva @relation(fields: [fk_idReserva], references: [id])
  carro   Carro?  @relation(fields: [fk_idCarro], references: [id])

  pagamentos Pagamento[]
  reembolsos Reembolso[]
  feedback   Feedback?

  @@index([fk_idCliente])
  @@index([fk_idReserva])
  @@index([fk_idCarro])
}

model Reserva {
  id          String       @id @default(uuid())
  status      String
  fk_vaga     String
  vaga        Vaga         @relation(fields: [fk_vaga], references: [id])
  reservasCli ReservaCli[]

  @@index([fk_vaga])
}

model Pagamento {
  id         String     @id @default(uuid())
  nome       String
  tipo       String
  valor      Float
  categoria  String     @default("taxa")
  criadoEm   DateTime   @default(now())
  fk_reserva String
  reservaCli ReservaCli @relation(fields: [fk_reserva], references: [id], onDelete: Cascade)

  @@index([fk_reserva])
  @@index([criadoEm])
}

model Reembolso {
  id            String    @id @default(uuid())
  valorPago     Float
  valorDevolver Float
  minutosUsados Int       @default(0)
  valorUsado    Float     @default(0)
  motivo        String    @default("")
  status        String    @default("Pendente")
  observacao    String    @default("")
  decididoPor   String?
  criadoEm      DateTime  @default(now())
  respondido    DateTime?
  fk_reservacli String
  fk_idCliente  String

  reservaCli ReservaCli @relation(fields: [fk_reservacli], references: [id], onDelete: Cascade)
  usuario    Usuario    @relation(fields: [fk_idCliente], references: [id], onDelete: Cascade)

  @@index([fk_reservacli])
  @@index([fk_idCliente])
}

model Feedback {
  id             String          @id @default(uuid())
  nota           Int
  assunto        String
  categoria      String
  mensagem       String
  createdAt      DateTime        @default(now())
  fk_idCliente   String
  fk_est         String?
  fk_reservacli  String?         @unique
  usuario        Usuario         @relation(fields: [fk_idCliente], references: [id], onDelete: Cascade)
  estacionamento Estacionamento? @relation(fields: [fk_est], references: [id], onDelete: SetNull)
  reservaCli     ReservaCli?     @relation(fields: [fk_reservacli], references: [id], onDelete: SetNull)
  notas          NotaFeedback[]

  @@index([fk_idCliente])
  @@index([fk_est])
}

model NotaFeedback {
  id          String   @id @default(uuid())
  categoria   String
  nota        Int
  comentario  String   @default("")
  fk_feedback String
  feedback    Feedback @relation(fields: [fk_feedback], references: [id], onDelete: Cascade)

  @@unique([fk_feedback, categoria])
  @@index([fk_feedback])
}

model Vaga {
  id             String         @id @default(uuid())
  numero         String
  tipo           String
  status         String
  preco          Float          @default(0)
  fk_est         String
  reservas       Reserva[]
  estacionamento Estacionamento @relation(fields: [fk_est], references: [id])

  @@index([fk_est])
}

model Estacionamento {
  id            String        @id @default(uuid())
  nome          String
  status        String
  fk_idEndereco String        @unique
  endereco      Endereco      @relation(fields: [fk_idEndereco], references: [id])
  funcionarios  Funcionario[]
  vagas         Vaga[]
  feedbacks     Feedback[]
}

model Funcionario {
  id             String         @id @default(uuid())
  nome           String
  dataNascimento DateTime
  cpf            String         @unique
  telefone       String
  email          String         @unique
  senha          String
  fk_tipofunc    String
  fk_est         String
  estacionamento Estacionamento @relation(fields: [fk_est], references: [id])
  tipoFunc       TipoFunc       @relation(fields: [fk_tipofunc], references: [id])

  // Última redefinição de senha: tokens de login emitidos antes dela deixam de valer
  senhaAlteradaEm DateTime?

  @@index([fk_est])
  @@index([fk_tipofunc])
}

// Configuração do envio de e-mail (SMTP). Existe uma única linha (id = "smtp"),
// gerenciada pelo administrador em Configurações. A senha fica cifrada (AES-256-GCM).
model ConfigEmail {
  id             String   @id
  host           String
  porta          Int
  seguro         Boolean
  usuario        String
  senhaCifrada   String
  emailRemetente String
  nomeRemetente  String
  urlFront       String
  verificadoEm   DateTime
  atualizadoEm   DateTime @updatedAt
  atualizadoPor  String?
}

// Pedidos de recuperação de senha. Só o hash (SHA-256) do token é guardado:
// o token em si existe apenas no link enviado por e-mail.
// tipo: 'usuario' | 'funcionario' · contaId: id na tabela correspondente
model RecuperacaoSenha {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  tipo      String
  contaId   String
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  @@index([tipo, contaId])
}

model TipoFunc {
  id           String        @id @default(uuid())
  nome         String
  tipo         String
  funcionarios Funcionario[]
}
